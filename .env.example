# Server Port
PORT=5000

# PostgreSQL Database connection string
# Examples:
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Neon: postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/offhome?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/offhome?schema=public"

# Node Environment
NODE_ENV=development
